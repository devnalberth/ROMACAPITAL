Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Recursos públicos do consórcio: PHP no Apache, função Node na Vercel.
RewriteRule ^api/consorcio-media/?$ proxy/consorcio-media.php [L,QSA]

# Nunca servir credenciais nem os includes do proxy como arquivo estático.
<FilesMatch "^(config|config\.example)\.php$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/includes/
# Só o arquivo da Vercel, que no Apache seria texto inútil. NÃO bloquear ^/api/
# inteiro: /api/cartas é a rota real do catálogo.
RedirectMatch 404 ^/api/cartas\.js$

# Proxy do catálogo de cartas: /api/cartas -> proxy/cartas.php (QSA preserva ?tipo= e ?status=).
# O PHP fica FORA de /api/ porque a Vercel reserva essa pasta para Serverless Functions
# e recusa dois arquivos com o mesmo nome-base (cartas.js + cartas.php).
# Na Vercel o mesmo caminho /api/cartas é atendido por api/cartas.js automaticamente.
RewriteRule ^api/cartas/?$ proxy/cartas.php [L,QSA]

# O blog foi descontinuado: as URLs antigas passam a apontar para a home.
RewriteRule ^(conteudos|consorcio-como-estrategia|liquidez-e-aquisicao|expansao-empresarial)/?$ /inicio [R=301,L]
RewriteRule ^(news|news-details|post-liquidez-aquisicao|post-expansao-empresarial)\.html$ /inicio [R=301,L]

# Redireciona acessos aos arquivos HTML para suas URLs amigáveis.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ /inicio [R=301,L]

RewriteCond %{THE_REQUEST} \s/+about\.html(?:[?\s]) [NC]
RewriteRule ^about\.html$ /sobre [R=301,L]

RewriteCond %{THE_REQUEST} \s/+contempladas\.html(?:[?\s]) [NC]
RewriteRule ^contempladas\.html$ /contempladas [R=301,L]

RewriteCond %{THE_REQUEST} \s/+contact\.html(?:[?\s]) [NC]
RewriteRule ^contact\.html$ /contato [R=301,L]

RewriteCond %{THE_REQUEST} \s/+service-details\.html(?:[?\s]) [NC]
RewriteRule ^service-details\.html$ /estrategias-patrimoniais [R=301,L]

RewriteCond %{THE_REQUEST} \s/+team-details\.html(?:[?\s]) [NC]
RewriteRule ^team-details\.html$ /equipe [R=301,L]

# Mantém uma única versão das URLs, sem barra final.
RewriteRule ^(inicio|sobre|contempladas|contato|estrategias-patrimoniais|equipe)/$ /$1 [R=301,L]

# A página inicial também utiliza seu nome, em vez do arquivo index.html.
RewriteRule ^$ /inicio [R=301,L]

# Entrega os arquivos existentes sem expor a extensão no navegador.
RewriteRule ^inicio$ index.html [L]
RewriteRule ^sobre$ about.html [L]
RewriteRule ^contato$ contact.html [L]
RewriteRule ^contempladas$ contempladas.html [L]
RewriteRule ^estrategias-patrimoniais$ service-details.html [L]
RewriteRule ^equipe$ team-details.html [L]

ErrorDocument 404 /404.html
